# Load into the shell with: set -a; source .env; set +a

# Required to publish and to schedule; oex reads them when it pushes to HDX or uses S3
HDX_API_KEY=
HDX_OWNER_ORG=
HDX_MAINTAINER=
OEX_S3_BUCKET=

# AWS credentials: the instance role, AWS_PROFILE, or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# AWS_PROFILE=

# Optional
# OEX_S3_REGION=us-east-1
# Empty for a bucket whose policy grants public reads.
# OEX_S3_ACL=public-read
# Outputs, the planet and .sweep/; the repo folder when unset.
# OEX_DATA_DIR=/mnt/data
# Memory oex may use, in GB; detected from RAM and the cgroup limit when unset.
# OEX_MEMORY_GB=18

# Tasking Manager
# TM_API=https://tasking-manager-production-api.hotosm.org/api/v2
# Folder of dated sandbox exports, for just tm-sandbox; the newest is used.
# TM_SANDBOX_PBF=s3://<bucket>/exports/
# Projects per osmium extract pass.
# TM_EXTRACT_BATCH=6
