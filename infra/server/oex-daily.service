[Unit]
Description=OSM country exports, daily due sweep
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Set User and the checkout path for this machine.
User=oex
ExecStart=/opt/hot-data-exports/infra/server/oex-daily.sh
TimeoutStartSec=infinity
# Leaves room for sshd and the system when an export runs away.
MemoryHigh=75%
MemoryMax=87%
MemorySwapMax=0
