[Unit]
Description=HOT data exports, due events
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# Set the env file, the data folder and the memory cap (leave room for the system) for this machine.
ExecStart=/usr/bin/podman run --rm --init --replace --name oex-watch --pull=newer --env-file /etc/hot-data-exports.env \
    --volume /mnt/disk/hot-data-exports:/data --memory 26g --memory-swap 26g \
    ghcr.io/hotosm/hot-data-exports:main --group events --due
# 3 means another sweep holds the lock, and the next run tries again; 130 means it was stopped.
SuccessExitStatus=3 130
# 90 seconds covers the sweep's 60-second stop grace for running jobs.
ExecStop=/usr/bin/podman stop --ignore --time 90 oex-watch
TimeoutStopSec=120
